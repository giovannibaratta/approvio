model RefreshToken {
  id                                                                         String          @id @db.Uuid
  tokenHash                                                                  String          @unique(map: "refresh_tokens_token_hash_unique") @map("token_hash")
  familyId                                                                   String          @map("family_id") @db.Uuid
  accountId                                                                  String          @map("account_id") @db.Uuid
  sessionId                                                                  String          @map("session_id") @db.Uuid
  providerConnectionId                                                       String          @map("provider_connection_id") @db.Uuid
  status                                                                     String
  usedAt                                                                     DateTime?       @map("used_at") @db.Timestamptz(6)
  nextTokenId                                                                String?         @map("next_token_id") @db.Uuid
  expiresAt                                                                  DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt                                                                  DateTime        @map("created_at") @db.Timestamptz(6)
  occ                                                                        BigInt
  platformAccounts                                                           PlatformAccount @relation(fields: [accountId], references: [id], onUpdate: NoAction, map: "fk_refresh_tokens_account")
  browserSessionsRefreshTokensAccountIdSessionIdTobrowserSessions            BrowserSession  @relation("refresh_tokens_account_id_session_idTobrowser_sessions", fields: [accountId, sessionId], references: [accountId, id], onUpdate: NoAction, map: "fk_refresh_tokens_account_session")
  refreshTokens                                                              RefreshToken?   @relation("refresh_tokensTorefresh_tokens", fields: [nextTokenId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_refresh_tokens_next_token")
  otherRefreshTokens                                                         RefreshToken[]  @relation("refresh_tokensTorefresh_tokens")
  browserSessionsRefreshTokensSessionIdProviderConnectionIdTobrowserSessions BrowserSession  @relation("refresh_tokens_session_id_provider_connection_idTobrowser_sessions", fields: [sessionId, providerConnectionId], references: [id, providerConnectionId], onUpdate: NoAction, map: "fk_refresh_tokens_session_provider")

  @@index([familyId], map: "idx_refresh_tokens_family_id")
  @@map("refresh_tokens")
}

