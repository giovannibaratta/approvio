generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Databasechangelog {
  id            String   @db.VarChar(255)
  author        String   @db.VarChar(255)
  filename      String   @db.VarChar(255)
  dateexecuted  DateTime @db.Timestamp(6)
  orderexecuted Int
  exectype      String   @db.VarChar(10)
  md5sum        String?  @db.VarChar(35)
  description   String?  @db.VarChar(255)
  comments      String?  @db.VarChar(255)
  tag           String?  @db.VarChar(255)
  liquibase     String?  @db.VarChar(20)
  contexts      String?  @db.VarChar(255)
  labels        String?  @db.VarChar(255)
  deploymentId  String?  @map("deployment_id") @db.VarChar(10)

  @@id([id, author, filename], map: "pk_databasechangelog")
  @@map("databasechangelog")
}

model Databasechangeloglock {
  id          Int       @id
  locked      Boolean
  lockgranted DateTime? @db.Timestamp(6)
  lockedby    String?   @db.VarChar(255)

  @@map("databasechangeloglock")
  @@ignore
}

model Group {
  id                    String                 @id @db.Uuid
  organizationId        String                 @map("organization_id") @db.Uuid
  name                  String
  description           String?
  createdAt             DateTime               @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @map("updated_at") @db.Timestamptz(6)
  occ                   BigInt
  agentGroupMemberships AgentGroupMembership[]
  groupMemberships      GroupMembership[]
  organizations         Organization           @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "fk_groups_organization")

  @@unique([organizationId, id], map: "groups_organization_id_unique")
  @@unique([organizationId, name], map: "groups_organization_name_unique")
  @@map("groups")
}

model GroupMembership {
  organizationId String       @map("organization_id") @db.Uuid
  groupId        String       @map("group_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  createdAt      DateTime     @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz(6)
  groups         Group        @relation(fields: [organizationId, groupId], references: [organizationId, id], onUpdate: NoAction, map: "fk_group_memberships_group")
  organizations  Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "fk_group_memberships_organization")
  users          User         @relation(fields: [organizationId, userId], references: [organizationId, id], onUpdate: NoAction, map: "fk_group_memberships_user")

  @@id([organizationId, groupId, userId], map: "pk_group_memberships")
  @@index([organizationId, userId], map: "idx_group_memberships_organization_user")
  @@map("group_memberships")
}

model User {
  id                      String                   @id @db.Uuid
  organizationId          String                   @map("organization_id") @db.Uuid
  platformAccountId       String                   @map("platform_account_id") @db.Uuid
  displayName             String                   @map("display_name")
  status                  String
  orgRole                 String                   @map("org_role")
  roles                   Json?
  createdAt               DateTime                 @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @map("updated_at") @db.Timestamptz(6)
  occ                     BigInt
  groupMemberships        GroupMembership[]
  organizationInvitations OrganizationInvitation[]
  stepUpReceipts          StepUpReceipt[]
  organizations           Organization             @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "fk_users_organization")
  platformAccounts        PlatformAccount          @relation(fields: [platformAccountId], references: [id], onUpdate: NoAction, map: "fk_users_platform_account")
  votes                   Vote[]

  @@unique([organizationId, platformAccountId], map: "users_organization_account_unique")
  @@unique([organizationId, id], map: "users_organization_id_unique")
  @@index([platformAccountId, status, organizationId], map: "idx_users_account_status_organization")
  @@map("users")
}

model Workflow {
  id                          String                       @id @db.Uuid
  organizationId              String                       @map("organization_id") @db.Uuid
  name                        String
  description                 String?
  createdAt                   DateTime                     @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                     @map("updated_at") @db.Timestamptz(6)
  status                      String
  occ                         BigInt
  recalculationRequired       Boolean                      @map("recalculation_required")
  workflowTemplateId          String                       @map("workflow_template_id") @db.Uuid
  expiresAt                   DateTime                     @map("expires_at") @db.Timestamptz(6)
  votes                       Vote[]
  workflowActionsEmailTasks   WorkflowActionsEmailTask[]
  workflowActionsSlackTasks   WorkflowActionsSlackTask[]
  workflowActionsWebhookTasks WorkflowActionsWebhookTask[]
  organizations               Organization                 @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "fk_workflows_organization")
  workflowTemplates           WorkflowTemplate             @relation(fields: [organizationId, workflowTemplateId], references: [organizationId, id], onUpdate: NoAction, map: "fk_workflows_template")

  @@unique([organizationId, id], map: "workflows_organization_id_unique")
  @@unique([organizationId, name], map: "workflows_organization_name_unique")
  @@map("workflows")
}

model WorkflowTemplate {
  id                              String       @id @db.Uuid
  organizationId                  String       @map("organization_id") @db.Uuid
  name                            String
  description                     String?
  approvalRule                    Json         @map("approval_rule")
  encActions                      String?      @map("enc_actions")
  defaultExpiresInHours           Int?         @map("default_expires_in_hours")
  createdAt                       DateTime     @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime     @map("updated_at") @db.Timestamptz(6)
  status                          String
  version                         Int
  allowVotingOnDeprecatedTemplate Boolean      @map("allow_voting_on_deprecated_template")
  occ                             BigInt
  spaceId                         String       @map("space_id") @db.Uuid
  organizations                   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "fk_workflow_templates_organization")
  spaces                          Space        @relation(fields: [organizationId, spaceId], references: [organizationId, id], onUpdate: NoAction, map: "fk_workflow_templates_space")
  workflows                       Workflow[]

  @@unique([organizationId, id], map: "workflow_templates_organization_id_unique")
  @@unique([organizationId, name, version], map: "workflow_templates_organization_name_version_unique")
  @@map("workflow_templates")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Vote {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  workflowId     String       @map("workflow_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  agentId        String?      @map("agent_id") @db.Uuid
  voteType       String       @map("vote_type")
  reason         String?
  votedForGroups String[]     @map("voted_for_groups")
  createdAt      DateTime     @map("created_at") @db.Timestamptz(6)
  agents         Agent?       @relation(fields: [organizationId, agentId], references: [organizationId, id], onUpdate: NoAction, map: "fk_votes_agent")
  organizations  Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "fk_votes_organization")
  users          User?        @relation(fields: [organizationId, userId], references: [organizationId, id], onUpdate: NoAction, map: "fk_votes_user")
  workflows      Workflow     @relation(fields: [organizationId, workflowId], references: [organizationId, id], onUpdate: NoAction, map: "fk_votes_workflow")

  @@unique([organizationId, id], map: "votes_organization_id_unique")
  @@index([organizationId, workflowId, userId, agentId, createdAt], map: "idx_votes_organization_workflow_actor_created")
  @@map("votes")
}

